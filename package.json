{
  "name": "rentpoc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:3001": "NEXT_DIST_DIR=.next-dev3001 next dev -p 3001",
    "dev:preview": "NEXT_DIST_DIR=.next-preview next dev",
    "build": "next build",
    "build:local": "scripts/heavy.sh build next build",
    "start": "next start",
    "lint": "scripts/heavy.sh lint eslint",
    "lint:inline-style": "INLINE_STYLE_REPORT=1 scripts/heavy.sh lint eslint",
    "typecheck": "scripts/heavy.sh typecheck sh -c 'next typegen && tsc --noEmit'",
    "test": "scripts/heavy.sh test vitest run",
    "test:scripts": "node --test \"scripts/hooks/*.test.mjs\" \"scripts/ci/*.test.mjs\" && scripts/heavy.test.sh",
    "test:pg": "scripts/pg-test.sh",
    "verify": "scripts/verify.sh",
    "e2e": "HEAVY_COST=6 scripts/heavy.sh e2e scripts/e2e/run-e2e.sh flows",
    "e2e:visual": "HEAVY_COST=6 scripts/heavy.sh e2e-visual scripts/e2e/run-e2e.sh visual",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate.mjs",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@google-cloud/storage": "8.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "antd": "^6.5.1",
    "dayjs": "^1.11.21",
    "fflate": "^0.8.3",
    "next": "16.2.11",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-rnd": "^10.5.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.65.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
