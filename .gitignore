# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite 資料（PoC 本機資料）
/data/

# Claude Code 個人設定（含 API key，不入版控）
.claude/settings.local.json

# 第二個 dev server 的 dist dir（prototype 驗證用）
/.next-dev3001/

# preview 驗證用 dev server 的 dist dir
/.next-preview/

# agent worktree（session 暫用）
/.claude/worktrees/

# 行銷網站用的 UI skill，assets 37 MB，不納入版控；後台用的 impeccable、ui-ux-pro-max、design-system 有 commit
/.claude/skills/design-taste-frontend/

# E2E（MIL-168）：dev server 的 dist dir、Playwright 的輸出與登入狀態
/.next-e2e-*/
/e2e-results/
/playwright-report/
vitest-report.json
